# ==============================================================================
# Glance — Point, Frame, Ask: Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VISION-LANGUAGE MODEL (VLM) API KEYS — Required for High-Precision Vision
# (Provide at least ONE of the following keys for vision identification)
# ------------------------------------------------------------------------------

# Qwen 2.5-VL 3B Instruct (Primary Multimodal VLM)
# Providers: Hugging Face Serverless, OpenRouter, DashScope, or Local Ollama
# Models: Qwen/Qwen2.5-VL-3B-Instruct, Qwen/Qwen2.5-VL-7B-Instruct, qwen/qwen-2.5-vl-72b-instruct:free, qwen2.5-vl:3b
QWEN_API_KEY=
VITE_QWEN_API_KEY=
QWEN_BASE_URL=https://router.huggingface.co/hf-inference/v1
VITE_QWEN_BASE_URL=https://router.huggingface.co/hf-inference/v1
QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
VITE_QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Anthropic Claude (Deep encyclopedic reasoning & museum narration)
# Model: claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Mistral AI (Pixtral 12B / Pixtral Large Multimodal Vision)
# Models: pixtral-12b-2409, pixtral-large-latest
MISTRAL_API_KEY=
VITE_MISTRAL_API_KEY=

# Google Gemini (Ultra-fast multimodal vision & generous free tier)
# Model: gemini-1.5-flash / gemini-2.0-flash
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# OpenAI (GPT-4o Vision & Whisper Speech-to-Text)
# Models: gpt-4o, whisper-1
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=

# Groq (Ultra-fast sub-200ms Whisper STT & Llama-3.2 Vision)
# Models: whisper-large-v3, llama-3.2-90b-vision-preview
GROQ_API_KEY=
VITE_GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
